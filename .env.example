# Supabase (project: Repass, ref vodawyrismhqosukohiv)
NEXT_PUBLIC_SUPABASE_URL=https://vodawyrismhqosukohiv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZvZGF3eXJpc21ocW9zdWtvaGl2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg1NjM2MDAsImV4cCI6MjEwNDEzOTYwMH0.780Y2JNPd3N9Ag4xO1LjyKXwvSBfrBcuHW49F_Pw5sM
# Get this from Supabase dashboard > Project Settings > API > service_role key. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (live account: CV Management Solutions). Get keys from the Stripe dashboard > Developers > API keys.
STRIPE_SECRET_KEY=
# Create a webhook endpoint (dashboard > Developers > Webhooks) pointed at
# <your-deployed-url>/api/webhooks/stripe, listening for checkout.session.completed,
# customer.subscription.updated, and customer.subscription.deleted. Copy its signing secret here.
# For local dev, use `stripe listen --forward-to localhost:3000/api/webhooks/stripe` instead.
STRIPE_WEBHOOK_SECRET=
# The live $49/month Repass Subscription price already created on the account.
STRIPE_PRICE_ID=price_1UC7fd4B3xICkowsKBGqUADL

# WalletWallet (https://www.walletwallet.dev/docs/) — get your key from their dashboard.
WALLETWALLET_API_KEY=

# Resend (https://resend.com) — for transactional email
RESEND_API_KEY=
# Must be on a domain verified in Resend before sending to real customers.
RESEND_FROM_EMAIL="Repass <hello@yourdomain.com>"

# Public URL this app is deployed at (no trailing slash). Used to build
# absolute links in emails and Stripe redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Square (https://developer.squareup.com) — lets a business connect their POS so a
# completed sale automatically awards a loyalty point. Get the Application ID/Secret
# from your Square Developer Dashboard (use the Sandbox pair while testing).
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
# "sandbox" or "production". Defaults to sandbox if unset.
SQUARE_ENVIRONMENT=sandbox

# Encrypts Square OAuth tokens at rest (AES-256-GCM). Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
POS_TOKEN_ENCRYPTION_KEY=
# Signs the OAuth `state` param so a Square connect callback can't be spoofed
# into attaching the wrong business. Any long random string.
SQUARE_OAUTH_STATE_SECRET=
